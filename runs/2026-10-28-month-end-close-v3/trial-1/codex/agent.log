se=dict.fromkeys(header,'');base.update(file=p.name,vendor=vendor,currency=curr,doc_type='credit_note' if 'CREDIT NOTE' in t else 'invoice',_duplicate=duplicate)\n if 'STATEMENT OF ACCOUNT' in t:\n  for line in t.splitlines():\n   m=re.fullmatch(r'([A-Z]+-\\\\d+)\\\\s+(\\\\d{4}-\\\\d\\\\d-\\\\d\\\\d)\\\\s+(\\\\d{4}-\\\\d\\\\d-\\\\d\\\\d)\\\\s+([\\\\d,.]+)\\\\s+([\\\\d,.]+)\\\\s+([\\\\d,.]+)',line):\n    pass\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='/work/close.py'\ns=open(p).read().replace(\\\"([\\\\\\\\d,.]+)',line):\\\\n    pass\\\", \\\"([\\\\\\\\d,.]+)',line)\\\\n   if m:\\\\n    r=base.copy();r.update(zip(['invoice_number','invoice_date','due_date','subtotal','tax','total'],m.groups()))\\\\n    for k in ['subtotal','tax','total']:r[k]=money(r[k])\\\\n    finish(r)\\\\n  continue\\\")\nopen(p,'w').write(s)\nPY\ncat >> /work/close.py <<'PY'\n r=base.copy()\n if 'CREDIT NOTE' in t: r['invoice_number']=match(r'Credit note no\\\\.\\\\s+(\\\\S+)',t)\n else:r['invoice_number']=match(r'(?:Invoice (?:No:|#:|number)|(?:INVOICE|lNVOICE)|Ref)\\\\s+([A-Z]+-\\\\d+)',t)\n if t.startswith('Subject:'):\n  r['invoice_date']=date(match(r'(?:dated |Invoice date )([A-Za-z]+ \\\\d+, \\\\d{4})',t))\n  r['due_date']=date(match(r'(?:Payment is due by |, due )([A-Za-z]+ \\\\d+, \\\\d{4})',t))\n  r['subtotal']=money(match(r'\\\\(net ([\\\\d,.]+)',t));r['tax']=money(match(r'plus tax ([\\\\d,.]+)',t));r['total']=money(match(r'total(?: of)? [A-Z]{3} ([\\\\d,.]+)',t))\n else:\n  r['invoice_date']=date(match(r'\"'^(?:Invoice Date:|Tax point / date:|Rechnungsdatum:|Date:|Date  |Issued)'\"\\\\s*(.*?)(?:\\\\s{2,}Due.*)?\"'$'\"',t) or match(r'\\\\bIssued\\\\s+(.+?)\\\\s{3}',t),us='USA' in t)\n  r['due_date']=date(match(r'\"'^(?:Due Date:|Payment due:|Zahlbar bis / Due:|Due:|Terms: due|Please pay by)'\"\\\\s*(.+)\"'$'\"',t) or match(r'\\\\bDue  +([\"'^'\"\\\\n]+)',t) or match(r'Payment due (.+?)\\\\s{3}',t),us='USA' in t)\n  euro='Rechnung / Invoice' in t\n  r['subtotal']=amounts(t,r'(?:Subtotal|Sub total|Net amount|Net credit|Nettobetrag \\\\(net\\\\)|Carried forward|Net\\\\s)',euro)\n  r['tax']=amounts(t,r'(?:Tax|Sales tax|VAT|MwSt\\\\./VAT)',euro)\n  r['total']=amounts(t,r'(?:TOTAL|Total due|Total payable|Total credit|Invoice total|Gesamtbetrag \\\\(total\\\\)|Amount due)',euro)\n if r['doc_type']=='credit_note':\n  for k in ['subtotal','tax','total']:\n   if r[k]:r[k]='-'+r[k].lstrip('-')\n assert all(r[k] for k in ['invoice_number','vendor','invoice_date','currency','subtotal','tax','total']),r\n finish(r)\nunique={}\nfor r in rows:\n key=(r['vendor'].casefold(),r['invoice_number'],r['doc_type'])\n if key in unique:\n  prev=unique[key]\n  assert all(prev[k]==r[k] for k in ['invoice_date','due_date','currency','subtotal','tax','total']), (prev,r)\n  if prev['_duplicate'] and not r['_duplicate']:\n   duplicates.append(prev['file']);unique[key]=r\n  else:duplicates.append(r['file'])\n else:unique[key]=r\nout=sorted(unique.values(),key=lambda r:r['file'])\nwith open('/work/output.csv','w',newline='') as f:\n w=csv.DictWriter(f,fieldnames=header,extrasaction='ignore');w.writeheader();w.writerows(out)\nprint('rows',len(out),'types',dict(Counter(r['doc_type'] for r in out)))\nprint('excluded',excluded);print('duplicates',duplicates)\nprint('review',[(r['file'],r['invoice_number'],r['subtotal'],r['tax'],r['total']) for r in out if r['needs_review']=='yes'])\nprint('missing due',[(r['file'],r['invoice_number']) for r in out if not r['due_date']])\nPY\npython3 /work/close.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

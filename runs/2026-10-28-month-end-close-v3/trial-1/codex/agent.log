{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"cat > /work/close.py <<'PY'\nfrom pathlib import Path\nimport re,csv\nfrom datetime import datetime\nfrom decimal import Decimal\nfrom collections import Counter\nheader='file,invoice_number,vendor,doc_type,invoice_date,due_date,currency,subtotal,tax,total,needs_review'.split(',')\nrows=[]; excluded=[]; duplicates=[]\ndef match(p,t):\n m=re.search(p,t,re.M|re.I)\n return m.group(1).strip() if m else ''\ndef date(s,us=False):\n if not s:return ''\n for fmt in ['%Y-%m-%d','%B %d, %Y','%d %b %Y','%m/%d/%Y' if us else '%d/%m/%Y','%d.%m.%Y']:\n  try:return datetime.strptime(s.strip().rstrip('.'),fmt).strftime('%Y-%m-%d')\n  except ValueError:pass\n raise ValueError(s)\ndef money(s,euro=False):\n if not s:return ''\n s=s.replace('.','').replace(',','.') if euro else s.replace(',','')\n return format(Decimal(s),'.2f')\ndef amounts(t,label,euro=False):\n s=match(r'\"'^'\"'+label+r'[\"'^'\"\\\\n]*?([0-9][0-9.,]*[.,][0-9]{2})(?:\\\\s*(?:USD|GBP|EUR|€))?\\\\s*\"'$'\"',t)\n return money(s,euro)\ndef finish(r):\n r['needs_review']='yes' if all(r[x] for x in ['subtotal','tax','total']) and Decimal(r['subtotal'])+Decimal(r['tax'])\"'!=Decimal(r['\"'total']) else 'no'\n rows.append(r)\nfor p in sorted(Path('/work/inputs').glob('*.txt')):\n t=p.read_text()\n if re.search(r'PURCHASE ORDER|REMITTANCE ADVICE|PAYMENT RECEIPT|QUOTATION',t):\n  excluded.append(p.name);continue\n duplicate='DUPLICATE COPY' in t or 'Subject: RESENT' in t\n t=re.sub(r'\"'^'\"\\\\*\\\\*\\\\* DUPLICATE COPY[\"'^'\"\\\\n]*\\\\n','',t)\n vendor=re.split(r'\\\\s+\\\\|\\\\s+| - |\\\\s{3,}Page',t.splitlines()[0])[0]\n if t.startswith('Subject: Fwd:'): vendor=match(r'Kind regards,\\\\n([\"'^'\"\\\\n]+)',t)\n if t.startswith('Subject: RESENT'):vendor=match(r'Thanks,\\\\n([\"'^'\"\\\\n]+)',t)\n curr=match(r'\\\\b(USD|EUR|GBP)\\\\b',t) or next((c for s,c in [('\"'$'\"','USD'),('€','EUR'),('£','GBP')] if s in t),'')\n base=dict.fromkeys(header,'');base.update(file=p.name,vendor=vendor,currency=curr,doc_type='credit_note' if 'CREDIT NOTE' in t else 'invoice',_duplicate=duplicate)\n if 'STATEMENT OF ACCOUNT' in t:\n  for line in t.splitlines():\n   m=re.fullmatch(r'([A-Z]+-\\\\d+)\\\\s+(\\\\d{4}-\\\\d\\\\d-\\\\d\\\\d)\\\\s+(\\\\d{4}-\\\\d\\\\d-\\\\d\\\\d)\\\\s+([\\\\d,.]+)\\\\s+([\\\\d,.]+)\\\\s+([\\\\d,.]+)',line):\n    pass\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

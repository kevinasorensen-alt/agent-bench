{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,re\nfrom pathlib import Path\nfrom datetime import date\nfrom decimal import Decimal\nrows=list(csv.DictReader(open('/work/output.csv')))\nfor r in rows:\n t=(Path('/work/inputs')/r['file']).read_text()\n assert r['invoice_number'] in t and r['vendor'] in t\n for k in ['invoice_date','due_date']:\n  if r[k]:date.fromisoformat(r[k])\n for k in ['subtotal','tax','total']:\n  v=r[k]\n  assert re.fullmatch(r'-?\\\\d+\\\\.\\\\d{2}',v)\n  n=abs(Decimal(v))\n  english=format(n,',.2f');european=english.translate(str.maketrans(',.','.,'))\n  assert english in t or european in t or str(n) in t,(r['file'],k,v)\n  if r['doc_type']=='credit_note':assert Decimal(v)<=0\n assert r['currency'] in ['USD','EUR','GBP']\n assert r['needs_review']==('yes' if Decimal(r['subtotal'])+Decimal(r['tax'])\"'!=Decimal(r['\"'total']) else 'no')\nassert len({(r['vendor'].casefold(),r['invoice_number']) for r in rows})==len(rows)\nassert len(rows)==138-10-8+4\nprint('Validated all 124 rows: source names and amounts, date formats, signs, unique invoices, review flags, and document accounting.')\nprint(Path('/work/output.csv').read_text()[:1800])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
